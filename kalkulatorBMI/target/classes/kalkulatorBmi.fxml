<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="650.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BmiController">
   <children>
      <Button layoutX="39.0" layoutY="350.0" mnemonicParsing="false" onAction="#hitungBMI" prefHeight="63.0" prefWidth="200.0" text="Hitung ">
         <font>
            <Font size="24.0" />
         </font>
      </Button>
      <TextField fx:id="txtBerat" layoutX="50.0" layoutY="221.0" prefHeight="41.0" prefWidth="386.0" />
      <TextField fx:id="txtTinggi" layoutX="50.0" layoutY="146.0" prefHeight="41.0" prefWidth="386.0">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </TextField>
      <Label layoutX="146.0" layoutY="33.0" text="BMI KALKULATOR">
         <font>
            <Font name="Romantic" size="24.0" />
         </font>
      </Label>
      <Label layoutX="51.0" layoutY="112.0" text="Tinggi Badan: ">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="51.0" layoutY="194.0" text="Berat Badan:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbJenisKelamin" layoutX="50.0" layoutY="275.0" prefHeight="41.0" prefWidth="386.0" promptText="Jenis Kelamin:" />
      <Button layoutX="278.0" layoutY="350.0" mnemonicParsing="false" onAction="#resetForm" prefHeight="63.0" prefWidth="200.0" text="Reset">
         <font>
            <Font size="24.0" />
         </font>
      </Button>
      <Label fx:id="lblHasil" layoutX="62.0" layoutY="460.0" text="Hasil BMI akan muncul di sini." />
      <ButtonBar layoutX="150.0" layoutY="82.0" prefHeight="40.0" prefWidth="200.0" />
   </children>
</AnchorPane>
